DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clms
DB_USER=
DB_PASSWORD=

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
WORKSTATION_API_KEY=

# Proposed monitoring policy; agree these values with the desktop team.
MONITORING_HEARTBEAT_INTERVAL_SECONDS=30
MONITORING_OFFLINE_AFTER_SECONDS=120
MONITORING_MAX_CLOCK_SKEW_SECONDS=5

# JSON: workstation ID -> SHA-256 digest of a unique random agent key.
# Empty disables agent authentication until credentials are provisioned.
WORKSTATION_AGENT_KEY_HASHES={}

# JSON: IDs of the unassigned registration reader and Arduino, when registered.
REGISTRATION_DEVICE_IDS={}

# Optional absolute private directory; default is instance/camera_captures.
SNAPSHOT_STORAGE_ROOT=

